    const total = data.reduce((a,b)=>a+b,0);
    return {
      type: 'bar',
      data: {
        labels: labelsArr,
        datasets: [{ data: data, backgroundColor: colorsArr, borderRadius: 4, barPercentage: 0.6 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function(ctx) {
                const v = ctx.raw;
                const pct = ((v/total)*100).toFixed(1);
                return ctx.label + ': ' + v.toLocaleString() + '  (' + pct + '%)';
              }
            }
          }
        },
        scales: { y: { beginAtZero: true }, x: { grid: { display: false } } }
      }
    };
  };

  new Chart(document.getElementById('metricRefDomains'), metricChartConfig([2392, 7832, 4208, 4323]));
  new Chart(document.getElementById('metricDR'), metricChartConfig([64, 80, 76, 77]));
  new Chart(document.getElementById('metricTraffic'), metricChartConfig([4515, 51105, 6269, 20330]));
  new Chart(document.getElementById('metricKeywords'), metricChartConfig([884, 3537, 2308, 1191]));
  new Chart(document.getElementById('metricTrafficValue'), metricChartConfig([12724, 237241, 14692, 127449]));
  new Chart(document.getElementById('metricBacklinks'), metricChartConfig([14132, 329789, 25600, 781030]));

  // 11. AIO count chart
  new Chart(document.getElementById('aioCountChart'), {
    type: 'bar',
    data: {
      labels: labelsArr,
      datasets: [
        { label: 'AIO Keywords', data: [7, 25, 18, 25], backgroundColor: '#1a56db', yAxisID: 'y', borderRadius: 4 },
        { label: 'AIO Traffic', data: [1, 1850, 28, 251], backgroundColor: '#f59e0b', yAxisID: 'y1', borderRadius: 4 }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom' } },
      scales: {
        y: { type: 'linear', position: 'left', title: { display: true, text: 'AIO Keyword Count' } },
        y1: { type: 'linear', position: 'right', title: { display: true, text: 'AIO Traffic / mo' }, grid: { drawOnChartArea: false } },
        x: { grid: { display: false } }
      }
    }
  });

}, 100);
</script>
